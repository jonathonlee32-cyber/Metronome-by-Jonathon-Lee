<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      调音器要用麦克风采集声音做实时基频检测，所以只申请这一个权限。

      注意这里没有 INTERNET 权限：调音器完全在本机运行 —— 不上传音频、不调用任何在线服务，
      应用本身也连不了网。音频数据只在内存里过一遍 DSP，不写文件、不出设备。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPractice">

        <!--
          应用入口：系统启动这个 Activity 来显示界面。

          这里刻意不写 android:screenOrientation：主页面和"BPM 测速"页都要支持横屏
          （横屏有专门的布局），方向交给系统按设备姿态决定。
          只有开屏页面要求"始终竖屏"，而它不是独立的 Activity，只是 MainActivity 里
          先显示的一屏，所以那条竖屏锁定写在 MainActivity.onCreate 里，
          启动页一结束就恢复 SCREEN_ORIENTATION_UNSPECIFIED。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
